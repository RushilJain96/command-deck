# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Exploratory camera studies from scripts/render-ship-frames.py --contact
render-study/

# Blender/Python bytecode from the frame renderer
scripts/__pycache__/

# Per-machine Claude Code settings; .claude/launch.json IS tracked.
.claude/settings.local.json
